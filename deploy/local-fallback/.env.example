# AuthSys local fallback only. Copy to .env and keep .env private.
NODE_ENV=development

# Host ports. These are loopback-only by default.
AUTH_PORT=8080
CLIENT1_PORT=3001
CLIENT2_PORT=3002

# Local AuthSys URLs (plain HTTP; no DuckDNS/VPS/HTTPS)
BASE_URL=http://localhost:8080
AUTH_SERVER_URL=http://localhost:8080
AUTH_PUBLIC_URL=http://localhost:8080
TRUST_PROXY=1

# Local MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=local_mongo_password_change_me

# Development secrets only; replace if this file is used for a shared machine.
JWT_SECRET=local-only-jwt-secret-change-me-32-chars
SESSION_SECRET=local-only-session-secret-change-me-32
CSRF_SECRET=local-only-csrf-secret-change-me-32-chars
JWT_EXPIRE=1h

# AuthSys storage
USE_REDIS_SESSIONS=true
MAX_ACTIVE_SESSIONS=5
REDIS_REQUIRED=true
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=1500
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000
MONGO_CONNECT_TIMEOUT_MS=3000

# Browser clients allowed to call AuthSys
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:8080
RATE_LIMIT_WHITELIST=127.0.0.1,::1,::ffff:127.0.0.1
GENERAL_RATE_LIMIT_MAX=500
REQUEST_BODY_LIMIT=10kb
ADMIN_QUERY_LIMIT=1000
AUDIT_PII_SECRET=local-only-audit-pii-secret-change-me-32
DATA_RETENTION_DAYS=90

# Optional social login. Leave blank for username/password-only local testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

# Email is optional for local smoke tests.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=AuthSys Local
EMAIL_FROM_ADDRESS=local@example.invalid

# Kafka is off by default. Use --profile kafka after setting this to true.
USE_KAFKA_LOGGING=false
KAFKA_BROKER=kafka:29092
KAFKA_CLIENT_ID=authsys-local
KAFKA_CONNECT_TIMEOUT_MS=2000
KAFKA_RETRIES=1

# Client 1 OAuth registration
CLIENT_ID=
CLIENT_SECRET=
CLIENT_REDIRECT_URI=http://localhost:3001/callback
CLIENT_SESSION_SECRET=local-client-1-session-secret-change-me-32
CLIENT_APP_NAME=ShopHub Client App 1
CLIENT_COOKIE_SECURE=false

# Client 2 OAuth registration
CLIENT2_ID=
CLIENT2_SECRET=
CLIENT2_REDIRECT_URI=http://localhost:3002/callback
CLIENT2_SESSION_SECRET=local-client-2-session-secret-change-me-32
CLIENT2_APP_NAME=Workspace Client 2
CLIENT2_COOKIE_SECURE=false

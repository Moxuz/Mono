{
  "openapi": "3.0.3",
  "info": {
    "title": "AuthSys API",
    "version": "23.0.0",
    "description": "Private OAuth 2.0 and OpenID Connect provider. Authorization Code + PKCE is the supported browser flow."
  },
  "servers": [
    { "url": "https://testmono-user.duckdns.org", "description": "Current HTTPS deployment" },
    { "url": "http://localhost:8080", "description": "Local Docker fallback" }
  ],
  "tags": [
    { "name": "Discovery" },
    { "name": "Authentication" },
    { "name": "OAuth/OIDC" },
    { "name": "Clients" },
    { "name": "Sessions" },
    { "name": "Privacy" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Discovery"],
        "summary": "Dependency readiness",
        "responses": {
          "200": { "description": "MongoDB and required Redis connections are ready" },
          "503": { "description": "A required dependency is unavailable" }
        }
      }
    },
    "/.well-known/openid-configuration": {
      "get": {
        "tags": ["Discovery"],
        "summary": "OpenID Provider metadata",
        "responses": { "200": { "description": "OIDC discovery document" } }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": ["Discovery"],
        "summary": "RS256 public signing keys",
        "responses": { "200": { "description": "JSON Web Key Set" } }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Create a local account and browser session",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } }
        },
        "responses": {
          "201": { "description": "Account and HttpOnly browser session created" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "description": "Username or email already exists" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Sign in for the AuthSys web UI",
        "description": "Creates an HttpOnly session cookie. Tokens are not returned to browser JavaScript.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "Authenticated browser session", "headers": { "Set-Cookie": { "schema": { "type": "string" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/auth/login/token": {
      "post": {
        "tags": ["Authentication"],
        "summary": "First-party API login",
        "description": "Compatibility endpoint for trusted first-party test tooling. OAuth clients should use Authorization Code + PKCE.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "Session-bound access and refresh tokens", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Read the current browser session",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Authentication state; returns authenticated=false when signed out" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Revoke the current login and clear its browser session",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Signed out" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Request a password reset",
        "description": "Always returns the same public response to prevent account enumeration.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string", "format": "email", "maxLength": 254 } } } } }
        },
        "responses": { "200": { "description": "Enumeration-safe acknowledgement" } }
      }
    },
    "/api/auth/reset-password/{token}": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Set a new password with a one-time reset token",
        "parameters": [{ "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["password"], "properties": { "password": { "type": "string", "minLength": 8, "maxLength": 128 } } } } }
        },
        "responses": {
          "200": { "description": "Password changed and existing sessions revoked" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/auth/profile": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Current account profile",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Profile" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "tags": ["Sessions"],
        "summary": "List active sessions",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": { "200": { "description": "Sanitized session list" } }
      }
    },
    "/api/sessions/{sessionId}": {
      "delete": {
        "tags": ["Sessions"],
        "summary": "Revoke one owned session",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" } }],
        "responses": {
          "200": { "description": "Session revoked" },
          "404": { "description": "Owned session not found" }
        }
      }
    },
    "/api/sessions/others/all": {
      "delete": {
        "tags": ["Sessions"],
        "summary": "Revoke every session except the authenticated one",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": { "200": { "description": "Other sessions revoked" } }
      }
    },
    "/api/oauth/authorize": {
      "get": {
        "tags": ["OAuth/OIDC"],
        "summary": "Start Authorization Code flow",
        "parameters": [
          { "name": "response_type", "in": "query", "required": true, "schema": { "type": "string", "enum": ["code"] } },
          { "name": "client_id", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "redirect_uri", "in": "query", "required": true, "schema": { "type": "string", "format": "uri" } },
          { "name": "scope", "in": "query", "required": true, "schema": { "type": "string", "example": "openid profile email" } },
          { "name": "state", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "nonce", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "code_challenge", "in": "query", "required": true, "schema": { "type": "string", "minLength": 43, "maxLength": 128 } },
          { "name": "code_challenge_method", "in": "query", "required": true, "schema": { "type": "string", "enum": ["S256"] } },
          { "name": "prompt", "in": "query", "schema": { "type": "string", "enum": ["none"] } }
        ],
        "responses": {
          "302": { "description": "Login/consent page or registered redirect URI" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "tags": ["OAuth/OIDC"],
        "summary": "Allow or deny the displayed consent request",
        "security": [{ "cookieAuth": [] }],
        "responses": { "200": { "description": "JSON redirect_url containing a code or OAuth error" } }
      }
    },
    "/api/oauth/token": {
      "post": {
        "tags": ["OAuth/OIDC"],
        "summary": "Exchange a code or rotate a refresh token",
        "description": "Accepts client_secret_basic or client_secret_post. Authorization codes require S256 PKCE.",
        "requestBody": {
          "required": true,
          "content": { "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/OAuthTokenRequest" } }, "application/json": { "schema": { "$ref": "#/components/schemas/OAuthTokenRequest" } } }
        },
        "responses": {
          "200": { "description": "OAuth token response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/oauth/userinfo": {
      "get": {
        "tags": ["OAuth/OIDC"],
        "summary": "OIDC UserInfo for a live OAuth access token",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Claims permitted by the granted scopes" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/oauth/introspect": {
      "post": {
        "tags": ["OAuth/OIDC"],
        "summary": "Introspect a token owned by the authenticated client",
        "security": [{ "clientBasic": [] }],
        "responses": {
          "200": { "description": "RFC 7662-style active result" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/oauth/revoke": {
      "post": {
        "tags": ["OAuth/OIDC"],
        "summary": "Revoke a token owned by the authenticated client",
        "security": [{ "clientBasic": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Token revoked" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/oauth/clients": {
      "get": {
        "tags": ["Clients"],
        "summary": "List OAuth clients owned by the current user",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": { "200": { "description": "Paginated clients without client secrets" } }
      },
      "post": {
        "tags": ["Clients"],
        "summary": "Register a confidential web client",
        "description": "The plaintext client_secret is shown only once.",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClientRegistration" } } }
        },
        "responses": {
          "201": { "description": "Client ID and one-time client secret" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/oauth/clients/{clientId}": {
      "get": {
        "tags": ["Clients"],
        "summary": "Read an owned client",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ClientId" }],
        "responses": { "200": { "description": "Client metadata" }, "404": { "description": "Client not found" } }
      },
      "put": {
        "tags": ["Clients"],
        "summary": "Update mutable client metadata",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ClientId" }],
        "responses": { "200": { "description": "Updated client" }, "404": { "description": "Client not found" } }
      },
      "delete": {
        "tags": ["Clients"],
        "summary": "Deactivate an owned client and revoke its consents",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ClientId" }],
        "responses": { "200": { "description": "Client deactivated" }, "404": { "description": "Client not found" } }
      }
    },
    "/api/oauth/consents": {
      "get": {
        "tags": ["Privacy"],
        "summary": "List current active OAuth consents",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": { "200": { "description": "Active grants and expiry dates" } }
      }
    },
    "/api/oauth/consents/{clientId}": {
      "delete": {
        "tags": ["Privacy"],
        "summary": "Revoke consent and invalidate the client's grant-bound tokens",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ClientId" }],
        "responses": { "200": { "description": "Consent revoked" } }
      }
    },
    "/api/users/export": {
      "get": {
        "tags": ["Privacy"],
        "summary": "Export the current user's retained data",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": { "200": { "description": "PDPA data export" } }
      }
    },
    "/api/users/account": {
      "delete": {
        "tags": ["Privacy"],
        "summary": "Deactivate and anonymize the current account",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": { "200": { "description": "Account anonymized and credentials/grants revoked" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "connect.sid" },
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "clientBasic": { "type": "http", "scheme": "basic", "description": "OAuth client_id and client_secret" }
    },
    "parameters": {
      "ClientId": { "name": "clientId", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 128 } }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password", "consentEssential"],
        "properties": {
          "username": { "type": "string", "minLength": 3, "maxLength": 64 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "minLength": 8, "maxLength": 128 },
          "consentEssential": { "type": "boolean", "enum": [true] }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "maxLength": 128 },
          "remember": { "type": "boolean", "default": false }
        }
      },
      "OAuthTokenRequest": {
        "type": "object",
        "required": ["grant_type"],
        "properties": {
          "grant_type": { "type": "string", "enum": ["authorization_code", "refresh_token"] },
          "code": { "type": "string" },
          "redirect_uri": { "type": "string", "format": "uri" },
          "code_verifier": { "type": "string", "minLength": 43, "maxLength": 128 },
          "refresh_token": { "type": "string" },
          "client_id": { "type": "string" },
          "client_secret": { "type": "string" }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" },
          "id_token": { "type": "string" },
          "token_type": { "type": "string", "enum": ["Bearer"] },
          "expires_in": { "type": "integer", "example": 3600 },
          "scope": { "type": "string" }
        }
      },
      "ClientRegistration": {
        "type": "object",
        "required": ["client_name", "redirect_uris"],
        "properties": {
          "client_name": { "type": "string", "minLength": 2, "maxLength": 100 },
          "redirect_uris": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "format": "uri" } },
          "description": { "type": "string", "maxLength": 500 },
          "logo_uri": { "type": "string", "format": "uri" },
          "contact_email": { "type": "string", "format": "email" }
        }
      }
    },
    "responses": {
      "BadRequest": { "description": "Invalid or unsupported request" },
      "Unauthorized": { "description": "Authentication or token validation failed" },
      "RateLimited": { "description": "Rate limit exceeded" }
    }
  }
}

<mxfile host="app.diagrams.net">
  <diagram id="main" name="Use Case Diagram">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TITLE -->
        <mxCell id="t1" value="TAS Authentication Server — Use Case Diagram"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=15;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="180" y="10" width="720" height="28" as="geometry"/>
        </mxCell>

        <!-- SYSTEM BOUNDARY (no packages inside — spacing only) -->
        <mxCell id="sb" value="TAS Authentication Server"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2F6FAE;strokeWidth=2;fontSize=13;fontStyle=1;verticalAlign=top;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="235" y="45" width="582" height="1065" as="geometry"/>
        </mxCell>

        <!-- ===========================================================
             LEFT COLUMN  (x=245, w=240)
             Groups separated by 40 px whitespace. No sub-boxes.
             =========================================================== -->

        <!-- Account Management  (y 80–344) -->
        <mxCell id="UC_REG"     value="Register Account"  style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="80"  width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_LOGIN"   value="Login (Local)"      style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="135" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_LGOOGLE" value="Login via Google"   style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="190" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_LGITHUB" value="Login via GitHub"   style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="245" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_LOGOUT"  value="Logout"             style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="300" width="240" height="45" as="geometry"/></mxCell>

        <!-- Password Management  (y 385–539, gap 40) -->
        <mxCell id="UC_FORGOT"   value="Forgot Password"  style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="385" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_RESET"    value="Reset Password"   style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="440" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_CHANGEPW" value="Change Password"  style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="495" width="240" height="45" as="geometry"/></mxCell>

        <!-- Profile &amp; Settings  (y 580–844, gap 40) -->
        <mxCell id="UC_PROFILE"  value="View / Update Profile"       style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="580" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_PREFS"    value="Update Preferences"          style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="635" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_ACTIVITY" value="View Activity Log"           style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="690" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_EXPORT"   value="Export Personal Data (PDPA)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="745" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_DELETE"   value="Delete Account"              style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="800" width="240" height="45" as="geometry"/></mxCell>

        <!-- Session Management  (y 885–1039, gap 40)  [moved to left so Admin lines stay short] -->
        <mxCell id="UC_SESSIONS" value="View Active Sessions" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="885" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_REVOKESS" value="Revoke Session"       style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="940" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_LOCKDOWN" value="Emergency Lockdown"   style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="995" width="240" height="45" as="geometry"/></mxCell>

        <!-- ===========================================================
             RIGHT COLUMN  (x=535, w=240)

        <mxCell id="eu6"  value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_FORGOT"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu7"  value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_RESET"    parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu8"  value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_CHANGEPW" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu9"  value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_PROFILE"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu10" value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_PREFS"    parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu11" value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_ACTIVITY" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu12" value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_EXPORT"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu13" value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_DELETE"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu14" value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_SESSIONS" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu15" value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_REVOKESS" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu16" value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_LOCKDOWN" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu17" value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_REGCLIENT"    parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu18" value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_MGMTCLIENT"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu19" value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_CONSENT"       parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu20" value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_REVOKECONSENT" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===========================================================
             ADMIN ASSOCIATIONS
             Admin Dashboard (5 UCs) + Session Management (3 UCs) — FIXED
             =========================================================== -->
        <mxCell id="ea1" value="" style="html=1;endArrow=none;" edge="1" source="ACT_ADMIN" target="UC_USERS"     parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2" value="" style="html=1;endArrow=none;" edge="1" source="ACT_ADMIN" target="UC_ANALYTICS" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea3" value="" style="html=1;endArrow=none;" edge="1" source="ACT_ADMIN" target="UC_LOGS"      parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea4" value="" style="html=1;endArrow=none;" edge="1" source="ACT_ADMIN" target="UC_MONITOR"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea5" value="" style="html=1;endArrow=none;" edge="1" source="ACT_ADMIN" target="UC_EXPORTLOG" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- FIXED: Admin → Session Management -->
        <mxCell id="ea6" value="" style="html=1;endArrow=none;" edge="1" source="ACT_ADMIN" target="UC_SESSIONS"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea7" value="" style="html=1;endArrow=none;" edge="1" source="ACT_ADMIN" target="UC_REVOKESS"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea8" value="" style="html=1;endArrow=none;" edge="1" source="ACT_ADMIN" target="UC_LOCKDOWN"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===========================================================
             EXTERNAL SYSTEM ASSOCIATIONS
             =========================================================== -->
        <mxCell id="eg1" value="" style="html=1;endArrow=none;" edge="1" source="ACT_GOOGLE" target="UC_LGOOGLE" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg2" value="" style="html=1;endArrow=none;" edge="1" source="ACT_GITHUB" target="UC_LGITHUB" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- OAuth Client App — FIXED: only 4 OAuth-operation UCs -->
        <mxCell id="ec1" value="" style="html=1;endArrow=none;" edge="1" source="ACT_CLIENT" target="UC_TOKEN"      parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec2" value="" style="html=1;endArrow=none;" edge="1" source="ACT_CLIENT" target="UC_REFRESH"    parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec3" value="" style="html=1;endArrow=none;" edge="1" source="ACT_CLIENT" target="UC_INTROSPECT" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec4" value="" style="html=1;endArrow=none;" edge="1" source="ACT_CLIENT" target="UC_USERINFO"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Email Service — plain associations (no «notify») -->
        <mxCell id="em1" value="" style="html=1;endArrow=none;" edge="1" source="ACT_EMAIL" target="UC_REG"      parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="em2" value="" style="html=1;endArrow=none;" edge="1" source="ACT_EMAIL" target="UC_LOGIN"    parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="em3" value="" style="html=1;endArrow=none;" edge="1" source="ACT_EMAIL" target="UC_FORGOT"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="em4" value="" style="html=1;endArrow=none;" edge="1" source="ACT_EMAIL" target="UC_RESET"    parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="em5" value="" style="html=1;endArrow=none;" edge="1" source="ACT_EMAIL" target="UC_CHANGEPW" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===========================================================
             «extend» RELATIONSHIPS  (dashed, fontSize=13)

             CORRECT direction: extending UC → base UC (arrowhead at base)

             Login via Google «extend» Login (Local):
               UC_LGOOGLE → UC_LOGIN  (Login via Google is optional/extending)
               Routed LEFT to avoid visual overlap with GitHub arrow

             Login via GitHub «extend» Login (Local):
               UC_LGITHUB → UC_LOGIN
               Routed RIGHT to avoid overlap with Google arrow

             Forgot Password «extend» Reset Password:
               UC_FORGOT → UC_RESET  (Forgot is the optional trigger)
             =========================================================== -->

        <!-- ext1: Login via Google «extend» Login (Local) — LEFT side routing -->
        <mxCell id="ext1" value="«extend»"
          style="dashed=1;html=1;endArrow=open;endFill=0;fontSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;"
          edge="1" source="UC_LGOOGLE" target="UC_LOGIN" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="222" y="212"/>
              <mxPoint x="222" y="180"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ext2: Login via GitHub «extend» Login (Local) — RIGHT side routing to avoid overlap -->
        <mxCell id="ext2" value="«extend»"
          style="dashed=1;html=1;endArrow=open;endFill=0;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;"
          edge="1" source="UC_LGITHUB" target="UC_LOGIN" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="508" y="267"/>
              <mxPoint x="508" y="180"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ext3: Forgot Password «extend» Reset Password -->
        <mxCell id="ext3" value="«extend»"
          style="dashed=1;html=1;endArrow=open;endFill=0;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="UC_FORGOT" target="UC_RESET" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===========================================================
             «include» RELATIONSHIPS
             Routed to opposite sides so they do NOT overlap:
               inc1 → left side of ellipses
               inc2 → right side of ellipses
             =========================================================== -->

        <!-- inc1: Exchange Code for Token «include» Grant Authorization — LEFT side -->
        <mxCell id="inc1" value="«include»"
          style="dashed=1;html=1;endArrow=open;endFill=0;fontSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;"
          edge="1" source="UC_TOKEN" target="UC_CONSENT" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="512" y="297"/>
              <mxPoint x="512" y="265"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- inc2: Refresh Access Token «include» Grant Authorization — RIGHT side (no overlap) -->
        <mxCell id="inc2" value="«include»"

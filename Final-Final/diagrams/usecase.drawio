        <!-- OAuth Client Management  (y 80–179) -->
        <mxCell id="UC_REGCLIENT"  value="Register OAuth Client" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="80"  width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_MGMTCLIENT" value="Manage OAuth Clients"  style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="135" width="240" height="45" as="geometry"/></mxCell>

        <!-- OAuth 2.0 Server  (y 220–594, gap 40) -->
        <mxCell id="UC_CONSENT"       value="Grant Authorization (Consent)"  style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="220" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_TOKEN"         value="Exchange Code for Token"         style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="275" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_REFRESH"       value="Refresh Access Token"            style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="330" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_INTROSPECT"    value="Introspect Token"                style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="385" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_USERINFO"      value="Get User Info"                   style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="440" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_REVOKETOKEN"   value="Revoke Token"                    style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="495" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_REVOKECONSENT" value="Revoke OAuth Consent (PDPA)"     style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="550" width="240" height="45" as="geometry"/></mxCell>

        <!-- Admin Dashboard  (y 635–889, gap 40) -->
        <mxCell id="UC_USERS"     value="View All Users"        style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="635" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_ANALYTICS" value="View Analytics"        style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="690" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_LOGS"      value="View Security Logs"    style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="745" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_MONITOR"   value="Monitor System Health" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="800" width="240" height="45" as="geometry"/></mxCell>
        <mxCell id="UC_EXPORTLOG" value="Export Audit Logs"     style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2F6FAE;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="855" width="240" height="45" as="geometry"/></mxCell>

        <!-- ===========================================================
             ACTORS — LEFT (human actors, warm yellow fill)
             =========================================================== -->

        <!-- User — positioned to minimise line distances to frequently-used UCs -->
        <mxCell id="ACT_USER" value="User"
          style="shape=umlActor;html=1;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;align=center;fillColor=#FFFBCC;strokeColor=#B8860B;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="410" width="40" height="60" as="geometry"/>
        </mxCell>

        <!-- Admin — between Session Mgmt (left, y≈885) and Admin Dashboard (right, y≈635) -->
        <mxCell id="ACT_ADMIN" value="Admin"
          style="shape=umlActor;html=1;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;align=center;fillColor=#FFFBCC;strokeColor=#B8860B;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="760" width="40" height="60" as="geometry"/>
        </mxCell>

        <!-- Generalization Admin→User (hollow triangle at User, Admin IS-A User) -->
        <mxCell id="GEN" value=""
          style="html=1;endArrow=block;endFill=0;endSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;"
          edge="1" source="ACT_ADMIN" target="ACT_USER" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===========================================================
             ACTORS — RIGHT (external systems, grey fill, «system» label)
             All positioned outside system boundary right edge (x=817)
             =========================================================== -->

        <!-- Google OAuth — aligned with Login via Google (y≈212) -->
        <mxCell id="ACT_GOOGLE" value="«system»&#xa;Google OAuth"
          style="shape=umlActor;html=1;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;align=center;fillColor=#f5f5f5;strokeColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="868" y="183" width="40" height="60" as="geometry"/>
        </mxCell>

        <!-- GitHub OAuth — aligned with Login via GitHub (y≈267) -->
        <mxCell id="ACT_GITHUB" value="«system»&#xa;GitHub OAuth"
          style="shape=umlActor;html=1;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;align=center;fillColor=#f5f5f5;strokeColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="868" y="258" width="40" height="60" as="geometry"/>
        </mxCell>

        <!-- Email Service — aligned with Account+Password UCs (center ≈ y310) -->
        <mxCell id="ACT_EMAIL" value="«system»&#xa;Email Service"
          style="shape=umlActor;html=1;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;align=center;fillColor=#f5f5f5;strokeColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="868" y="430" width="40" height="60" as="geometry"/>
        </mxCell>

        <!-- OAuth Client App — aligned with OAuth 2.0 Server group (center y≈407) -->
        <mxCell id="ACT_CLIENT" value="«system»&#xa;OAuth Client App"
          style="shape=umlActor;html=1;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;align=center;fillColor=#f5f5f5;strokeColor=#666666;"
          vertex="1" parent="1">

        </mxCell>

        <!-- ===========================================================
             USER ASSOCIATIONS
             =========================================================== -->
        <mxCell id="eu1"  value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_REG"      parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu2"  value="" style="html=1;endArrow=none;" edge="1" source="ACT_USER" target="UC_LOGIN"    parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    {
      "name": "05 — Security Headers & Rate Limit",
      "item": [
        {
          "name": "Security headers on /",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('X-Frame-Options set', () => pm.expect(pm.response.headers.get('X-Frame-Options')).to.be.a('string'));",
              "pm.test('X-Content-Type-Options: nosniff', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));",
              "pm.test('X-XSS-Protection set', () => pm.expect(pm.response.headers.get('X-XSS-Protection')).to.be.a('string'));",
              "pm.test('Content-Security-Policy set', () => pm.expect(pm.response.headers.get('Content-Security-Policy')).to.be.a('string'));",
              "pm.test('No X-Powered-By header', () => pm.expect(pm.response.headers.get('X-Powered-By')).to.not.exist);"
            ], "type": "text/javascript" }
          }]
        },
        {
          "name": "Wrong password → 401 (not 500)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"nobody@example.com\",\"password\":\"wrong\"}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 400 or 401 (not 500)', () => pm.expect([400,401,429]).to.include(pm.response.code));",
              "pm.test('Not 500', () => pm.expect(pm.response.code).to.not.equal(500));"
            ], "type": "text/javascript" }
          }]
        },
        {
          "name": "Rate limit headers present",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"k6user1@example.com\",\"password\":\"K6Test99!\"}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }

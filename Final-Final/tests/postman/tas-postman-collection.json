              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"client_name\":\"Postman Test Client\",\"contact_email\":\"pmtest@example.com\",\"redirect_uris\":[\"http://localhost:3000/callback\"],\"grant_types\":[\"authorization_code\",\"refresh_token\"]}"
            },

          "name": "POST /api/auth/register — new user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"pmtest{{$timestamp}}\",\"email\":\"pmtest{{$timestamp}}@example.com\",\"password\":\"PMTest99!\",\"confirmPassword\":\"PMTest99!\",\"consentEssential\":true}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('success true', () => pm.expect(pm.response.json().success).to.be.true);",
              "pm.test('Has user object', () => pm.expect(pm.response.json().data).to.have.property('user'));",
              "pm.test('Has token', () => { const d = pm.response.json().data; pm.expect(d.token || d.accessToken).to.be.a('string'); });"
            ], "type": "text/javascript" }
          }]
        },
        {

              "pm.test('Has accessToken', () => { const d = pm.response.json().data; pm.expect(d.token || d.accessToken).to.be.a('string'); });",
              "pm.test('Has refreshToken', () => pm.expect(pm.response.json().data.refreshToken).to.be.a('string'));",
              "pm.test('Response time < 3000ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
              "const d = pm.response.json().data;",

              "pm.test('Has client_secret', () => { const d = pm.response.json().data; pm.expect(d.client_secret || d.clientSecret).to.be.a('string'); });",
              "const d = pm.response.json().data;",
              "pm.collectionVariables.set('oauthClientId', d.client_id || d.clientId || '');",
              "pm.collectionVariables.set('oauthClientSecret', d.client_secret || d.clientSecret || '');"

{
  "name": "auth-monolith",
  "version": "1.0.0",
  "description": "Complete OAuth 2.0 / OpenID Connect Authentication Server with Kafka logging",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run test:functions && npm run test:audit && npm run test:modules && npm run test:security && npm run test:blue && npm run test:red",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:audit": "jest tests/audit-regressions.test.js --runInBand --detectOpenHandles",
    "test:integration": "jest tests/1-auth-core.test.js tests/2-auth-password.test.js tests/3-auth-sessions.test.js tests/4-auth-profile.test.js tests/5-oauth.test.js tests/6-security.test.js --detectOpenHandles --verbose --runInBand",
    "test:nginx": "jest tests/1-auth-core.test.js tests/2-auth-password.test.js tests/3-auth-sessions.test.js tests/4-auth-profile.test.js tests/5-oauth.test.js tests/6-security.test.js --detectOpenHandles --verbose --runInBand",
    "test:all": "npm run test:functions && npm run test:integration",
    "test:modules": "node tests/module-load.test.js",
    "test:security": "node tests/security-hardening.test.js",
    "test:blue": "node tests/blue-team-defense.test.js",
    "test:red": "node tests/red-team-pentest.test.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "kafka:up": "docker-compose -f docker-compose.kafka.yml up -d",
    "kafka:down": "docker-compose -f docker-compose.kafka.yml down",
    "kafka:logs": "node scripts/check-kafka-logs.js",
    "maintenance:scrub-audit": "node scripts/scrub-audit-pii.js",
    "test:functions": "node scripts/test-functions.js",
    "test:session": "node tests/session-expiry.test.js",
    "test:ui-live": "node scripts/ui-v23-audit.js",
    "client:up": "docker-compose -f docker-compose.client.yml up -d",
    "client:down": "docker-compose -f docker-compose.client.yml down"
  },
  "keywords": [
    "oauth2",
    "openid-connect",
    "authentication",
    "authorization",
    "sso",
    "jwt",
    "mongodb",
    "redis",
    "kafka"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "rate-limit-redis": "^4.2.0",
    "redis": "^5.11.0",
    "swagger-ui-dist": "^5.32.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}

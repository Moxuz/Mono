# Environment
NODE_ENV=development

# Server
PORT=5000
# Docker default is served through Nginx on port 80; use :5000 only for direct standalone app runs.
BASE_URL=http://localhost
TRUST_PROXY=false

# Database
MONGODB_URI=mongodb://localhost:27017/authdb
MONGO_ROOT_USERNAME=replace_with_mongo_username
MONGO_ROOT_PASSWORD=replace_with_a_long_random_password
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000
MONGO_CONNECT_TIMEOUT_MS=3000

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRE=1h

# Session Configuration
SESSION_SECRET=your_session_secret_here_min_32_chars
# Optional separate HMAC key for browser CSRF tokens. If omitted, SESSION_SECRET is used.
CSRF_SECRET=your_csrf_secret_here_min_32_chars
USE_REDIS_SESSIONS=false
MAX_ACTIVE_SESSIONS=5

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_REQUIRED=false

# Rate Limiting — comma-separated trusted IPs
RATE_LIMIT_WHITELIST=127.0.0.1
# General API requests per IP per 15 minutes (page/static GETs are excluded)
GENERAL_RATE_LIMIT_MAX=500
REQUEST_BODY_LIMIT=10kb
ADMIN_QUERY_LIMIT=1000

# HMAC key used to pseudonymize email/username values in security audits
AUDIT_PII_SECRET=replace_with_a_long_random_secret
# Retain soft-deleted user tombstones and revoked records for this many days
DATA_RETENTION_DAYS=90

# Browser clients allowed to call auth APIs (comma-separated; no wildcard with credentials)
CORS_ORIGIN=http://localhost:3001

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=Auth System
EMAIL_FROM_ADDRESS=noreply@example.com

# OAuth — Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# OAuth — GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Kafka (optional)
USE_KAFKA_LOGGING=false
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=auth-service
KAFKA_CONNECT_TIMEOUT_MS=2000
KAFKA_RETRIES=0

# OIDC signing keys (required in production; generate with openssl)
# OIDC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# OIDC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
OIDC_KEY_ID=authsys-1

# Client application / shared Docker network
CLIENT_ID=replace_with_registered_oauth_client_id
CLIENT_SECRET=replace_with_registered_oauth_client_secret
CLIENT_SESSION_SECRET=replace_with_a_random_32_byte_secret
CLIENT_MONGODB_URI=mongodb://admin:adminpassword@mongodb:27017/authdb?authSource=admin
AUTH_PUBLIC_URL=http://localhost
CLIENT_REDIRECT_URI=http://localhost:3001/callback
CLIENT_COOKIE_SECURE=false
CLIENT2_ID=replace_with_second_oauth_client_id
CLIENT2_SECRET=replace_with_second_oauth_client_secret
CLIENT2_REDIRECT_URI=http://localhost:3002/callback
CLIENT2_SESSION_SECRET=replace_with_another_random_32_byte_secret
CLIENT2_COOKIE_SECURE=false

# Public HTTPS hosts used by the VPS overlay
CLIENT_HOST=client-1.duckdns.org
CLIENT2_HOST=client-2.duckdns.org
CERT_NAME=testmono-user.duckdns.org
CLIENT2_CERT_NAME=client-2.duckdns.org
AUTH_NETWORK_NAME=auth-network

# Client App 1 - ShopHub E-commerce
# OAuth Client Configuration

# OAuth Client Credentials
# ⚠️ GET THESE FROM AUTH SERVER DEVELOPER PORTAL!
# 1. Start auth server: npm start (port 5000)
# 2. Login as admin at http://localhost:5000/login.html
# 3. Go to Developer Portal: http://localhost:5000/developer-portal.html
# 4. Register new client with redirect URI: http://localhost:3001/callback
# 5. Copy Client ID and Secret below
CLIENT_ID=YOUR_CLIENT_ID_HERE
CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Redirect URI (must match OAuth client registration)
REDIRECT_URI=http://localhost:3001/callback

# Session Secret (generate random string, min 32 chars)
SESSION_SECRET=super_secure_random_string_min_32_chars_here

# Port
PORT=3001

# OAuth Provider (your auth server)
OAUTH_PROVIDER=http://localhost:5000

# App Name
APP_NAME=ShopHub Client App 1
